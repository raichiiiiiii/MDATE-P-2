# Copy this file to .env in the repository root. Never commit .env.
COMPOSE_PROJECT_NAME=mdate-dev

# Local development network
LOCAL_IP=192.168.1.100
DEV_BIND_ADDRESS=0.0.0.0
NGINX_HTTP_PORT=8080
EXPO_PORT=8081
POSTGRES_HOST_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NATIVE_API_ORIGIN=http://192.168.1.100:8080

# Browser origin. For Cloudflare, change to https://<APP_HOSTNAME>.
APP_HOSTNAME=localhost
STORAGE_HOSTNAME=storage.example.com
APP_PUBLIC_ORIGIN=http://localhost:8080
# Optional override for MinIO server-wide CORS. Defaults to APP_PUBLIC_ORIGIN.
# Use a comma-separated list when the web app is served from multiple origins.
# MINIO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://192.168.1.100:8080
# For LAN testing use http://<LOCAL_IP>:9000. For Cloudflare set https://<STORAGE_HOSTNAME>.
MINIO_PUBLIC_ENDPOINT=http://192.168.1.100:9000

# PostgreSQL: use URL-safe characters in the password.
POSTGRES_USER=mdate
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=mdate

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=https://api.mdate.local
JWT_AUDIENCE=mdate-app
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# MinIO root = administration only; APP credentials are used by Express.
MINIO_ROOT_USER=mdate-root
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_APP_USER=mdate-app
MINIO_APP_PASSWORD=CHANGE_ME_MINIO_APP_PASSWORD
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_TTL_SECONDS=300

WHISPER_CPU_THREADS=4

# Optional mail server; without SMTP, password/email links are logged locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MDATE <no-reply@example.com>

# Optional Cloudflare Tunnel token. Use start-dev.ps1 -WithTunnel after setting it.
CLOUDFLARE_TUNNEL_TOKEN=

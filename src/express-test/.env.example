NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://mdate:YOUR_PASSWORD@localhost:5432/mdate

AUTH0_DOMAIN=YOUR_AUTH0_TENANT_DOMAIN
AUTH0_AUDIENCE=https://api.mdate.com

EXPO_WEB_ORIGIN=http://localhost:8081
MEDIA_STORAGE_DIR=./storage/media

# Local speech-inference model directory (relative to src/express-test unless absolute).
MDATE_WHISPER_MODEL_DIR=./models/whisper-aphasia
# Optional: absolute path to the Python executable in the environment with requirements-speech.txt installed.
# Use forward slashes in Windows paths, for example C:/Python312/python.exe.
# PYTHON_EXECUTABLE=C:/Python312/python.exe
# MDATE_SPEECH_STARTUP_TIMEOUT_MS=300000
# MDATE_SPEECH_REQUEST_TIMEOUT_MS=180000

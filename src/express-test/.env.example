NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://mdate:YOUR_PASSWORD@localhost:5432/mdate
# CORS allow-origin for explicitly cross-origin web integrations. The MDATE
# browser app uses same-origin API requests; auth origin protection compares
# the incoming Origin with Host + the forwarded public protocol.
EXPO_WEB_ORIGIN=http://localhost:8081
MEDIA_STORAGE_DIR=./storage/media

# Generate a unique 64+ character secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=https://api.mdate.local
JWT_AUDIENCE=mdate-app
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_BASE_URL=http://localhost:8081/reset-password
EMAIL_CHANGE_BASE_URL=http://localhost:8081/confirm-email-change

# MinIO application account: never use the MinIO root credentials here.
# For a tablet on the LAN, this endpoint must be reachable by both Express and the tablet.
MINIO_ENDPOINT=http://YOUR_PC_LAN_IP:9000
MINIO_APP_USER=
MINIO_APP_PASSWORD=
MINIO_REGION=us-east-1
MINIO_BUCKET_ASSETS=mdate-assets
MINIO_PRESIGNED_URL_TTL_SECONDS=300

# Optional during local development. Without SMTP, links are written to the Express console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MDATE <no-reply@example.com>

# Local speech-inference model directory.
MDATE_WHISPER_MODEL_DIR=./models/whisper-aphasia

{
  "expo": {
    "name": "MDATE",
    "slug": "mdate",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["web", "android", "ios"],
    "scheme": "mdate",
    "ios": { "bundleIdentifier": "com.mdate.app" },
    "android": { "package": "com.mdate.app" },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "MDATE uses your photo library so you can choose a profile picture." }],
      ["expo-audio", { "microphonePermission": "MDATE uses your microphone to transcribe practice answers.", "enableBackgroundRecording": false }]
    ],
    "web": { "bundler": "metro" }
  }
}

# Add these variables to C:\Users\User\dev\test\.env.
# Replace every example value with a different, long random secret.
# Local-only by default. For tablet direct uploads, see the README before changing this.
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_ROOT_USER=mdate-local-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ROOT_PASSWORD
MINIO_APP_USER=mdate-app-local
MINIO_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_APP_PASSWORD
